        margin-bottom: 50px;
        border-radius: 5px;
      }

      .bottom-dropdown {
        margin-top: 50px;
        padding: 20px;
        background-color: #e8e8e8;
        border: 1px solid #ccc;
        border-radius: 5px;
        bottom: 20px;
        width: 100%;
        left: 0;
        box-sizing: border-box;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="banner">
