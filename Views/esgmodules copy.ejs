    <style>
      /* Basic styling */
      img {
        width: 500px; /* picture size */
        border-radius: 10px; /* circular border radius */
        /* float: left; / place image next to text */
        margin-right: 10px; /* create space after image */
      } /* reference image */

      .img1 {
        width: 500px; /* picture size */
        border-radius: 10px; /* circular boarder radius */
        float: left; /* place image next to text */
        margin-right: 100px; /* create space after image */
        margin-left: 100px; /* create space before image */
      } /* reference image */
      p.title {
        font-family: Arial, sans-serif;
        font-weight: bold; /* bold font only for p user class */
        margin-top: 20px;
        margin-bottom: 20px;
        text-align: center;
        font-size: 42px;
        font-weight: bold;
      }

      /* Basic styling */
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0px;
        /* background-color: #f4f4f4; */
      }

      h1 {
        color: #333;
      }

      select {
        padding: 10px;
        font-size: 16px;
        margin-bottom: 20px;
        color: white;
        background-color: rgb(26, 160, 59);
      }

      .content {
        padding: 20px;
        background-color: white;
        /* border: 1px solid #ddd; */
