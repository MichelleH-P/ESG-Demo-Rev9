              <br>
              Location: <input type="text" id="location" name="location" value="" size="43">
              <br>
              File: <input type="file" name="doc">
              <br>
                    <br>
              <input type="submit" name="update" value="Upload">
              <input type="checkbox" name="no_upload">
              Delete without uploading
              <br>
              Upload Status: 
              <br>
        </form>

        `;
        }

        // Update the content at the top of the page
        topContent.innerHTML = content;
      });
    </script>
  </body>
</html>
