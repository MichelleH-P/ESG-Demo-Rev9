      class="img1"
      alt="image unavailable"
    />

    <!-- Content displayed at the top -->
    <div id="topContent" class="content">
      <p>
        Content will be displayed here based on your selection from the dropdown
        at the bottom of the page.
      </p>
    </div>

    <!-- Drop-down list at the bottom of the page -->
    <div class="bottom-dropdown">
      <label for="contentSelect">Choose a topic:</label>
      <select id="contentSelect">
        <option value="" selected disabled>Select an option...</option>
        <option value="option1">BTEX Table</option>
        <option value="option2">Sample Table</option>
        <option value="option3">Temperature vs Time</option>
        <option value="option4">Dummy Table 1</option>
        <option value="option5">Dummy Table 2</option>
        <option value="option6">Dummy Table 3</option>
        <option value="option7">QR Code 1</option>
        <option value="option8">QR Code 2</option>
      </select>
    </div>

    <script>
      // Get references to the select element and the top content container
      const contentSelect = document.getElementById("contentSelect");
      const topContent = document.getElementById("topContent");

      // Function to change content at the top based on the selected option
      contentSelect.addEventListener("change", function () {
        const selectedValue = this.value;

        let content = ""; // Content to display

        if (selectedValue === "option1") {
          content = `
          <h2>BTEX Table</h2>
          <br />
          <iframe
            src="https://btexeliminator.net/MOXA_report.php"
            width="60%"
            height="600"
            style="border: none"
            font-family: Arial, sans-serif;
          ></iframe>
          <p>Welcome to our website! We are a company that values excellence and innovation. Our mission is to provide top-notch services to our clients.</p>

          `;
        } else if (selectedValue === "option2") {
          content = `
          <h2>Sample Table</h2>
          <br />
          <h1>Sample Table</h1>

          <h2>Random 4x5 Table</h2>

          <table>
          <tr>
            <th>Header 1</th>
            <th>Header 2</th>
            <th>Header 3</th>
            <th>Header 4</th>
            <th>Header 5</th>
            </tr>
            <tr>
            <td>500</td>
            <td>24</td>
            <td>3</td>
            <td>18</td>
            <td>7</td>
            </tr>
            <tr>
            <td>5</td>
            <td>12</td>
            <td>29</td>
            <td>9</td>
            <td>15</td>
            </tr>
            <tr>
            <td>8</td>
            <td>14</td>
            <td>17</td>
            <td>6</td>
            <td>23</td>
            </tr>
            <tr>
            <td>21</td>
            <td>4</td>
            <td>19</td>
            <td>11</td>
            <td>16</td>
            </tr>
            </table>
            <br />
            <a href="../Tables/tables Index.html">Tables Index</a>
            <br />
            <a href="../home.html">Home</a>
          
          <ul>
            <li>Web Design and Development</li>
            <li>Mobile App Development</li>
            <li>SEO and Digital Marketing</li>
            <li>Cloud Solutions</li>
          </ul>
        `;
        } else if (selectedValue === "option3") {
          content = `
          <iframe
            src="/Public/ESG Tables/temperature vs time"
            width="60%"
            height="800"
            style="border: none"
          ></iframe>
        `;
        } else if (selectedValue === "option4") {
          content = `
          <iframe
            src="../Tables/dummy table.html"
            width="60%"
            height="800"
            style="border: none"
          ></iframe>
        `;
        } else if (selectedValue === "option5") {
          content = `
          <iframe
            src="../Tables/dummy table2.html"
            width="60%"
            height="800"
            style="border: none"
          ></iframe>
        `;
        } else if (selectedValue === "option6") {
          content = `
          <iframe
            src="../Tables/dummy table3.html"
            width="60%"
            height="800"
            style="border: none"
          ></iframe>
        `;
        } else if (selectedValue === "option7") {
          content = `
          <iframe
            src="Node_Login/Public/ESG modules/document_upload_test"
            width="60%"
            height="800"
            style="border: none"
          ></iframe>
        `;
        } else if (selectedValue === "option8") {
          content = `
            <form action="document_upload_test.php" method="POST" enctype="multipart/form-data">
              Unit Serial Number:
              <input type="text" value="" size="10" maxlength="10" name="serial_number">
              <br>
