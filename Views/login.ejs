<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="en" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="HTML,CSS" />
    <meta name="description" content="This page displays Log in Page" />
    <title>Log In</title>
    <link
      href="../public/assets/main menu.css"
      rel="stylesheet"
      type="text/css"
    />
    <!-- <script defer src="../js/login.js"></script> -->

    <style>
      img {
        width: 500px; /* picture size */
        border-radius: 10px; /* circular border radius */
        display: block;
        margin-left: auto;
        margin-right: auto;
        margin-top: 50px;
        margin-bottom: 50px;
      } /* reference image */
      p.username {
        font-weight: bold; /* bold font only for p user class */
      }

      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 14px 20px;
        display: block;
        margin-left: auto;
        margin-right: auto;
        text-align: center;
        /* background-color: #4caf50; */
      }

      /* .content {
        padding: 20px;
        background-color: rgb(190, 190, 190);
        /* border: 1px solid #ddd; */
      /* border-radius: 5px;
        margin-bottom: 50px;
        border-radius: 5px;
      } */
    </style>
  </head>
  <body>
    <img src="../public/Thumbnails/logo.png" alt="image unavailable" />
    <h1>Log In</h1>

    <br />

    <form action="/users/login" method="POST">
      <div>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="Email"
          required
        />
      </div>

      <br />

      <div>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Password"
          required
        />
      </div>

      <br />

      <div>
        <input type="submit" value="Login" />
      </div>

      <br />

      <a href="/users/register">Register</a>
    </form>
  </body>
</html>
