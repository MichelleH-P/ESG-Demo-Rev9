          /* border: 1px solid #ddd; */
          border-radius: 5px;
          margin-bottom: 50px;
          border-radius: 5px;
        }

        .table-container {
          width: 70%; /* Makes it smaller than the page */
          max-height: 900px;
          overflow-y: auto;
          margin: auto;
          margin-right: 5%;
          margin-left: 2%;
          float: right;
      }

      table {
          width: 100%;
          border-collapse: collapse;
      }
      th, td {
          padding: 8px;
          text-align: left;
          border: 1px solid #ddd;
      }
      th {
          background-color: #f4f4f4;
      }
      /* Sticky first 2 columns */
      td:first-child, td:nth-child(2),
      th:first-child, th:nth-child(2) {
          position: sticky;
          left: 0;
          background-color: #ffffff;
          z-index: 1;
      }
      td:nth-child(2), th:nth-child(2) {
          left: 100px;
      }
      /* Make the first row sticky */
      thead th {
        position: sticky;
        top: 0;
        background-color: #f4f4f4;
        z-index: 2;
    }
      /* First 2 columns wider */
      td:first-child, th:first-child {
          width: 150px;
      }
      td:nth-child(2), th:nth-child(2) {
          width: 200px;
      }

      .container {
            display: flex;
            max-width: 100%;
            margin-left: 10%;
        }
        .scrollable-list {
            max-height: 900px;
            overflow-y: auto;
            width: 20%;
            border-right: 1px solid #ddd;
        }
        .scrollable-list a {
            display: block;
            padding: 10px;
            text-decoration: none;
            background-color: #f4f4f4;
            margin-bottom: 5px;
            color: black;
            cursor: pointer;
        }
        .scrollable-list a:hover {
            background-color: #ddd;
        }
        .hidden {
          display: none;
      }
      /* Highlighting Yes/No fields */
      td.highlight-yes {
        background-color: green;
        color: white;
    }
    td.highlight-no {
        background-color: red;
        color: white;
    }
    .scroll-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      background-color: #ddd;
      padding: 5px;
  }
  .left-arrow {
      left: 0;
  }
  .right-arrow {
      right: 0;
  }
  .Yes {
    background-color: green;
    color: white;
  }
  .No {
