    <script>
        function showTable(tableId) {
            // Hide all tables
            const tables = document.querySelectorAll('.table-container > div');
            tables.forEach(table => table.classList.add('hidden'));

            // Show selected table
            const selectedTable = document.getElementById(tableId);
            if (selectedTable) {
                selectedTable.classList.remove('hidden');
            }
        }

      // JavaScript to highlight fields
      document.querySelectorAll('#data-table tbody td').forEach(cell => {
        if (cell.innerText === 'Yes') {
            cell.classList.add('highlight-yes');
        } else if (cell.innerText === 'No') {
            cell.classList.add('highlight-no');
        }
      });
      document.querySelectorAll('#main-table tbody td').forEach(cell => {
        if (cell.innerText === 'Yes') {
            cell.classList.add('highlight-yes');
        } else if (cell.innerText === 'No') {
            cell.classList.add('highlight-no');
        }
      });

    </script>

