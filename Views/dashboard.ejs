    }

    /* Style for the tab bar at the bottom */
    .tab-bar {

        width: 100%;
        display: flex;
        justify-content: space-around;
        background-color: #333;
    }

    /* Style for each tab */
    .tab-bar button {
        flex: 1;
        padding: 14px 20px;
        color: black;
        border: none;
        cursor: pointer;
        font-size: 16px;
        outline: none;
        transition: background-color 0.3s;
    }

    /* Hover effect for the tabs */
    .tab-bar button:hover {
        background-color: #575757;
    }

    /* Active tab style */
    .tab-bar button.active {
        background-color: #4CAF50;
    }

    /* Style for the tab content sections */
    .tab-content {
        display: none;
        text-align: left;
    }

    /* Display the active tab content */
    .tab-content.active {
        display: block;
    }
        /* Initial button style */
        .styled-button {
          background-color: #28a745; /* Green background */
          color: white; /* White text */
          padding: 10px 20px;
          border: none;
          border-radius: 5px;
          cursor: pointer;
          font-size: 16px;
          transition: background-color 0.3s ease; /* Smooth transition */
      }
      
      /* Hover effect */
      .styled-button:hover {
          background-color: #6c757d; /* Gray background on hover */
      }
      </style>
